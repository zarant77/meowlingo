MEOWLINGO_HOST=0.0.0.0
MEOWLINGO_PORT=8765
TRANSLATOR_PROVIDER=mock
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Defaults to ~/Zomboid/Logs; leave unset for automatic home directory detection.
# MEOWLINGO_LOG_DIR=/path/to/Zomboid/Logs
MEOWLINGO_READ_HISTORY=false

# Advertise the desktop on the local network using mDNS.
MEOWLINGO_DISCOVERY=true

# Attempt T, Ctrl+V, Enter only when Zomboid is foreground.
MEOWLINGO_AUTO_SEND=true

# Recent log messages loaded at startup and replayed to Android.
MEOWLINGO_HISTORY_COUNT=10
