{
  "name": "meowlingo-desktop-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "mock:chat": "tsx src/index.ts --mock-chat",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "desktop:dev": "node scripts/dev.mjs",
    "desktop:prepare": "npm run build && node scripts/build-native.mjs",
    "desktop:package": "npm run desktop:prepare && electron-forge package",
    "desktop:make": "npm run desktop:prepare && electron-forge make && node scripts/make-dmg.mjs && node ../scripts/collect-desktop-builds.mjs",
    "desktop:smoke": "npm run build && electron test/electron-smoke.cjs"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "clipboardy": "^4.0.0",
    "dotenv": "^16.4.7",
    "electron-squirrel-startup": "^1.0.1",
    "openai": "^7.27.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "electron": "^44.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "main": "electron/main.cjs",
  "productName": "MeowLingo",
  "description": "Project Zomboid chat companion with mobile messaging and translation",
  "author": "MeowLingo",
  "config": {
    "forge": "./forge.config.cjs"
  }
}
